# The collector bridge's credentials (doc 05). Copy to .env.bridge, which is gitignored; never commit
# real values. This file holds ONLY the keys below: the bridge refuses any other key, and in
# particular DATABRICKS_TOKEN (your dbt personal access token), which it must never use.
#
# The bridge reads it with:   python ingest/bridge/bridge.py            (default: .env.bridge at the repo root)
#                             python ingest/bridge/bridge.py --env-file path/to/.env.bridge
# Values already in the process environment win over this file. A local run (--local-dir) reads nothing.
#
# CLIENT_ID is the service principal's application ID (a UUID); the secret is shown once, when you
# generate it. Host without the https:// prefix is fine.
DATABRICKS_HOST=
BRIDGE_DATABRICKS_CLIENT_ID=
BRIDGE_DATABRICKS_CLIENT_SECRET=

# Monitoring (doc 05, "Monitoring"): OPTIONAL. The two dead-man's-switch ping URLs from Healthchecks.io, one per signal. Each URL is
# credential-like -- whoever holds it can mark a check up -- so never commit a real one; the bridge never prints or logs it. Leave a
# line empty to switch that signal off (the bridge logs one warning and carries on). Only workspace mode reads these; a --local-dir
# run never pings.
#   S1  bridge alive   a ping every 5 minutes while the MQTT client is connected
#   S3  data landed    a ping after an upload that landed at least one line, at most every 5 minutes
BRIDGE_PING_S1_URL=
BRIDGE_PING_S3_URL=
