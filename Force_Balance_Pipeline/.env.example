# Copy to .env and fill in. .env is gitignored; never commit real values.

# Databricks workspace (doc 05). Host without the https:// prefix is fine; the
# scripts normalise it. HTTP path looks like /sql/1.0/warehouses/<id>.
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=

# The collector bridge and the backfill upload use their own credentials, the OAuth client id and
# secret of the files-scoped service principal `force-bridge`. They live in .env.bridge (copy
# .env.bridge.example), never in this file, so that the bridge cannot pick up the personal access
# token above (doc 05).

# Inference (doc 04). Local: an AI Studio API key. On Cloud Run and the bridge the key is
# read from Secret Manager instead of this file.
GEMINI_API_KEY=
# INFERENCE_MODEL example: gemini-3.1-flash-lite
INFERENCE_MODEL=

# Local dbt target (doc 05, `local` profile)
POSTGRES_PASSWORD=
