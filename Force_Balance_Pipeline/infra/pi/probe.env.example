# The probe's configuration on the Pi (doc 04, Deployment on the Pi). deploy.sh copies this to /etc/force-probe/probe.env (root-owned,
# mode 0600) if that file is missing; fill it in there with:  sudoedit /etc/force-probe/probe.env
# NEVER put real values in this file or commit them. The password is the probe-01 user's, from the broker's password file (doc 05).
#
# PROBE_MQTT_HOST is the desktop's LAN address (a DHCP reservation keeps it stable).
PROBE_MQTT_HOST=
PROBE_MQTT_USERNAME=
PROBE_MQTT_PASSWORD=
