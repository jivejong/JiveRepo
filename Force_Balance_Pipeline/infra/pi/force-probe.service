# The probe on the Raspberry Pi 3 (doc 04, Deployment on the Pi). Installed by infra/pi/deploy.sh; start it with
#   sudo systemctl enable --now force-probe
#
# Ordering only: After=time-sync.target puts this service after the time-sync target, but that target waits for a real NTP
# synchronisation only if systemd-time-wait-sync.service is enabled. It does not guarantee a synchronised clock. What guarantees that no
# scan is stamped early is the probe's own NTPSynchronized check (doc 04, Clock): a scan due before sync is skipped and logged.
#
# The Phase 3 checkpoint (doc 07) passed 2026-09-29 (PHASE3-RESULTS.md): the simulated-outage schedule is on (--mode-schedule),
# doc 04's default (1-3 h, roughly twice a day, its own seed drawn at random on each start).
#
# Fault injection is now its own period, at doc 04's default rate (--fault-rate 1.0, explicit -- not the argparse default
# left to apply itself, so this file states the rate it runs at rather than relying on a number that lives only in
# edge/probe/main.py). Run separately from the mode schedule above so a scheduled outage and an injected fault are never
# running at the same time and an anomaly's cause stays unambiguous. fault_injection.jsonl in the state directory is the
# Phase 4 reconciliation source (doc 04) -- pull it (scp) before it grows unbounded, it has no cap of its own. probe.env
# holds only the three MQTT keys (below) — neither the fault rate nor the mode schedule reads from it, so this file is
# the one place that turns them on and off.
[Unit]
Description=Force Balance Pipeline probe (Raspberry Pi 3)
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target

[Service]
Type=simple
User=force-probe
Group=force-probe
WorkingDirectory=/opt/force-probe/repo/Force_Balance_Pipeline/edge
# PROBE_MQTT_HOST, PROBE_MQTT_USERNAME and PROBE_MQTT_PASSWORD; root-owned, mode 0600, never in the repository
EnvironmentFile=/etc/force-probe/probe.env
Environment=PROBE_STATE_DIR=/var/lib/force-probe
Environment=PROBE_VERSION_FILE=/opt/force-probe/version
Environment=PYTHONUNBUFFERED=1
StateDirectory=force-probe
StateDirectoryMode=0750
ExecStart=/opt/force-probe/venv/bin/python /opt/force-probe/repo/Force_Balance_Pipeline/edge/probe_sim.py --live --fault-rate 1.0 --mode-schedule
Restart=always
RestartSec=10

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
