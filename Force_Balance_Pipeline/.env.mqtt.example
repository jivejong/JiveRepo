# The bridge's MQTT credentials for the authenticated LAN broker (doc 04, Phase 3 staging). Copy to .env.mqtt, which is gitignored; never
# commit real values. It holds ONLY the two keys below: the bridge refuses any other key. In particular the operator password is never
# stored here (edge/probe_ctl.py asks for it), and the Databricks keys stay in .env.bridge.
#
# Values already in the process environment win over this file. The user is `force-bridge`, from the broker's password file (doc 05).
BRIDGE_MQTT_USERNAME=
BRIDGE_MQTT_PASSWORD=
