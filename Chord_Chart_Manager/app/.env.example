# Copy to .env and adjust. .env is gitignored; .env.example is committed.

# --- Postgres ---
POSTGRES_USER=chords
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=chords

# Host port the DB is published on in LOCAL dev (so the Python loader can
# reach it at localhost:5432). Ignored in prod (port isn't published).
DB_PORT=5432

# --- App ---
# Host port the web app is served on.
APP_PORT=3000

# --- Optional pipeline enrichment ---
# MusicBrainz requires a contact value in the API User-Agent.
MUSICBRAINZ_CONTACT=you@example.com

# Create a key at https://getsongbpm.com/api.
GETSONGBPM_API_KEY=
