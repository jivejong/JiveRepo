# Copy to .env and adjust. .env is gitignored; .env.example is committed.

# --- Postgres ---
POSTGRES_USER=chords
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=chords

# Host port the DB is published on in LOCAL dev (so the Python loader can
# reach it at localhost:15432 by default). Ignored in prod (port isn't published).
DB_PORT=15432

# --- App ---
# Host port the web app is served on.
APP_PORT=3000

# --- Optional pipeline enrichment ---
# Gemini fills missing song metadata. Leave empty to skip enrichment. Never commit a real key.
GEMINI_API_KEY=
