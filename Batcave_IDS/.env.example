# Optional. Without it, triage runs the rule-based baseline and every
# metric still reports (docs/04-llm-triage.md).
GEMINI_API_KEY=

# Redpanda (docs/05-local-environment.md)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=attack.events

# Honeypot (docs/02-data-model.md)
# Gap-based session derivation: a session for one batcave_sid cookie ends
# after this many seconds of inactivity (superseded from the Phase 1
# (source_ip, user_agent) key by the Phase 3 cookie - the cookie is what
# survives IP/UA rotation now; this gap only matters for a session that goes
# genuinely quiet). Default 120 suits an autopilot run, which never idles.
# Phase 8's console stack raises this to 900 so a human reading a technique
# menu doesn't get split into a fresh session mid-run (docs/02).
SESSION_GAP_SECONDS=120
# Off by default. docker-compose.yml turns this on explicitly for the
# honeypot container, where the compose-internal network is the only place
# a trusted caller (the simulator, from Phase 2+) can reach it from.
HONEYPOT_TRUST_FORWARDED_FOR=
