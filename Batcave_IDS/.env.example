# Optional. Without it, triage runs the rule-based baseline and every
# metric still reports (docs/04-llm-triage.md).
GEMINI_API_KEY=

# Redpanda (docs/05-local-environment.md)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=attack.events

# Honeypot (docs/02-data-model.md, Phase 1)
# Gap-based session derivation: a session for one (source_ip, user_agent)
# ends after this many seconds of inactivity.
SESSION_GAP_SECONDS=120
# Off by default. docker-compose.yml turns this on explicitly for the
# honeypot container, where the compose-internal network is the only place
# a trusted caller (the simulator, from Phase 2+) can reach it from.
HONEYPOT_TRUST_FORWARDED_FOR=
