# App modes (both default to true when omitted)
secured = true
gemini = true

# LLM credentials. Set gemini = false for the Groq-backed pipeline.
GENAI_API_KEY = "YOUR-GEMINI-API-KEY"
GROQ_API_KEY = "YOUR-GROQ-API-KEY"

[access.users]
owner = "REPLACE-WITH-LONG-RANDOM-OWNER-PASSWORD"
demo_user = "REPLACE-WITH-LONG-RANDOM-DEMO-PASSWORD"

[limits]
max_llm_calls_per_session = 20
