# Gemini API credentials
GEMINI_API_KEY = "YOUR-GEMINI-API-KEY"
# Optional: defaults to gemini-3.1-flash-lite
GEMINI_MODEL = "gemini-3.1-flash-lite"

[access.users]
owner = "REPLACE-WITH-LONG-RANDOM-OWNER-PASSWORD"
demo_user = "REPLACE-WITH-LONG-RANDOM-DEMO-PASSWORD"

[limits]
max_llm_calls_per_session = 20
