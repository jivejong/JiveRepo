# App modes (both default to true when omitted)
secured = true
gemini = true

# LLM credentials. Set gemini = false to use Groq GPT-OSS 120B.
GEMINI_API_KEY = "YOUR-GEMINI-API-KEY"
GROQ_API_KEY = "YOUR-GROQ-API-KEY"
# Optional: defaults to gemini-3.1-flash-lite
GEMINI_MODEL = "gemini-3.1-flash-lite"

[access.users]
owner = "REPLACE-WITH-LONG-RANDOM-OWNER-PASSWORD"
demo_user = "REPLACE-WITH-LONG-RANDOM-DEMO-PASSWORD"

[limits]
max_llm_calls_per_session = 20
