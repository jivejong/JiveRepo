# App modes (both default to true when omitted)
secured = true
gemini = true

# LLM credentials. Set gemini = false to use Groq GPT-OSS 120B.
GEMINI_API_KEY = "YOUR-GEMINI-API-KEY"
GROQ_API_KEY = "YOUR-GROQ-API-KEY"

[access.users]
owner = "REPLACE-WITH-LONG-RANDOM-ACCESS-CODE"
demo_user = "REPLACE-WITH-ANOTHER-LONG-RANDOM-ACCESS-CODE"

[limits]
# Applies to every named identity except `owner`.
max_billable_operations_per_session = 20
