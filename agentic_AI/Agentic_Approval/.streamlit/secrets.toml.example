# Gemini credential
GEMINI_API_KEY = "YOUR-GEMINI-API-KEY"

# Access codes are matched without asking visitors for a username.
[access.users]
owner = "REPLACE-WITH-A-LONG-RANDOM-OWNER-PASSWORD"
demo_user = "REPLACE-WITH-A-LONG-RANDOM-DEMO-PASSWORD"

# Applies to every non-owner session. The owner is unlimited.
[limits]
max_llm_calls_per_session = 20
