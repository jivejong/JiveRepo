# Copy this file to .env (gitignored) and fill in real values.
# Every project's Program.cs loads .env at startup via SuperHeroOps.Data's
# EnvFileLoader (or a local copy in SuperHeroOps.Ingestion.Heroes, which has no
# solution references) - values here become normal process environment variables,
# so shell-exported values always take precedence over this file.

# Required for SuperHeroOps.Ingestion.Heroes. Get a token by signing in at
# https://superheroapi.com with GitHub.
SUPERHERO_API_TOKEN=

# Required for Groq report generation in SuperHeroOps.Web (Phase 5+).
GROQ_API_KEY=

# Optional. Registers a Socrata app token to avoid throttling on the crime pull;
# not required at the 90-day pull volume this project uses.
# SOCRATA_APP_TOKEN=

# Optional. Overrides the local Postgres connection string (default matches
# docker-compose.yml: Host=localhost;Port=5433;Database=superheroops;
# Username=superheroops;Password=superheroops).
# SUPERHEROOPS_DB_CONNECTION=
