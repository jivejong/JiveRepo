@page "/heroes/{AreaId:int}"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using SuperHeroOps.Core
@using SuperHeroOps.Data
@inject IDbContextFactory<SuperHeroOpsDbContext> DbFactory
@inject NavigationManager Nav

<PageTitle>Find Heroes@(area is null ? "" : $" - {area.Name}") - SuperHeroOps</PageTitle>

@if (!found)
{
    <p><em>No community area found for id @AreaId.</em></p>
}
else if (area is null || heroes is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <p><a class="btn btn-outline-secondary" href="@($"neighborhoods/{AreaId}")">&larr; Back to @area.Name</a></p>

    <h1>Select Heroes to Deploy to @area.Name</h1>
    <p>Search for specific heroes or browse the full seeded roster of @heroes.Count heroes.</p>

    <div class="hero-selection-modes" role="group" aria-label="Hero selection method">
        <button type="button"
                class="btn @(browseAll ? "btn-outline-primary" : "btn-primary")"
                aria-pressed="@(!browseAll)"
                @onclick="ShowSearch">
            Search Heroes
        </button>
        <button type="button"
                class="btn @(browseAll ? "btn-primary" : "btn-outline-primary")"
                aria-pressed="@browseAll"
                @onclick="ShowBrowseAll">
            Browse Full Checklist
        </button>
    </div>

    @if (!browseAll)
    {
    <section class="hero-search-page" aria-label="Search heroes">
        <form class="hero-search-form" @onsubmit="Search" @onsubmit:preventDefault>
            <label class="form-label" for="hero-search">Search for superheroes</label>
            <div class="hero-search-controls">
                <div class="hero-autocomplete">
                    <input id="hero-search"
                           class="form-control form-control-lg"
                           type="search"
                           value="@searchQuery"
                           @oninput="HandleSearchInput"
                           @onfocus="ShowAutocomplete"
                           autocomplete="off"
                           placeholder="Try Batman, Diana Prince, or Marvel Comics"
                           aria-label="Search for superheroes"
                           aria-autocomplete="list"
                           aria-controls="hero-suggestions"
                           aria-expanded="@autocompleteVisible.ToString().ToLowerInvariant()" />

                    @if (autocompleteVisible)
                    {
                        <div id="hero-suggestions" class="hero-autocomplete-menu" role="listbox">
                            @if (Suggestions.Count > 0)
                            {
                                @foreach (var hero in Suggestions)
                                {
                                    <button type="button"
                                            class="hero-autocomplete-option"
                                            role="option"
                                            @onclick="() => ChooseSuggestion(hero.Name)">
                                        <span class="hero-avatar-placeholder" aria-hidden="true">@hero.Name[0]</span>
                                        <span>
                                            <strong>@hero.Name</strong>
                                            @if (!string.IsNullOrWhiteSpace(hero.Publisher))
                                            {
                                                <small>@hero.Publisher</small>
                                            }
                                        </span>
                                    </button>
                                }
                            }
                            else
                            {
                                <div class="hero-autocomplete-empty" role="option" aria-disabled="true">
                                    No heroes found for &ldquo;@searchQuery.Trim()&rdquo;
                                </div>
                            }
                        </div>
                    }
                </div>

                <button class="btn btn-primary btn-lg" type="submit" disabled="@(!CanSearch)">
                    Search
                </button>
            </div>
            <div class="form-text">Choose an autocomplete suggestion, or search any part of a name.</div>
        </form>
    </section>
    }
    else
    {
    <section class="hero-roster-browser" aria-label="Full hero checklist">
        <div class="hero-results-actions">
            <span><strong>@selected.Count</strong> selected</span>
            <button class="btn btn-success" disabled="@(selected.Count == 0)" @onclick="GoToDeploy">
                Deploy Selected Heroes &rarr;
            </button>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th scope="col">Select</th>
                        <th scope="col"></th>
                        <th scope="col">Name</th>
                        <th scope="col">Publisher</th>
                        <th scope="col">Alignment</th>
                        <th scope="col">Int</th>
                        <th scope="col">Str</th>
                        <th scope="col">Spd</th>
                        <th scope="col">Dur</th>
                        <th scope="col">Pow</th>
                        <th scope="col">Cmb</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var hero in PagedHeroes)
                    {
                        <tr>
                            <td>
                                <input class="form-check-input hero-select-checkbox"
                                       type="checkbox"
                                       aria-label="@($"Select {hero.Name}")"
                                       checked="@selected.Contains(hero.Id)"
                                       @onchange="e => ToggleSelected(hero.Id, (bool)e.Value!)" />
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(hero.ImagePath))
                                {
                                    <img src="/@hero.ImagePath" alt="" style="height:40px" />
                                }
                                else
                                {
                                    <span class="hero-avatar-placeholder" title="@hero.Name" aria-hidden="true">@hero.Name[0]</span>
                                }
                            </td>
                            <td><strong>@hero.Name</strong></td>
                            <td>@hero.Publisher</td>
                            <td>@hero.Alignment</td>
                            <td>@hero.Intelligence</td>
                            <td>@hero.Strength</td>
                            <td>@hero.Speed</td>
                            <td>@hero.Durability</td>
                            <td>@hero.Power</td>
                            <td>@hero.Combat</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <nav class="hero-roster-pagination" aria-label="Hero roster pages">
            <button class="btn btn-outline-secondary btn-sm" disabled="@(page == 0)" @onclick="() => ChangePage(-1)">
                &laquo; Previous
            </button>
            <span>Page @(page + 1) of @TotalPages</span>
            <button class="btn btn-outline-secondary btn-sm" disabled="@(page >= TotalPages - 1)" @onclick="() => ChangePage(1)">
                Next &raquo;
            </button>
        </nav>
    </section>
    }
}

@code {
    private const int SuggestionLimit = 8;
    private const int PageSize = 30;

    [Parameter]
    public int AreaId { get; set; }

    [SupplyParameterFromQuery(Name = "q")]
    public string? InitialQuery { get; set; }

    private CommunityArea? area;
    private bool found = true;
    private List<Hero>? heroes;
    private string searchQuery = string.Empty;
    private bool autocompleteVisible;
    private bool browseAll;
    private readonly HashSet<int> selected = [];
    private int page;

    private List<Hero> Suggestions => string.IsNullOrWhiteSpace(searchQuery) || heroes is null
        ? []
        : heroes
            .Where(hero => Matches(hero, searchQuery))
            .Take(SuggestionLimit)
            .ToList();

    private bool CanSearch => Suggestions.Count > 0;

    private int TotalPages => heroes is null
        ? 1
        : Math.Max(1, (int)Math.Ceiling(heroes.Count / (double)PageSize));

    private IEnumerable<Hero> PagedHeroes => heroes!.Skip(page * PageSize).Take(PageSize);

    protected override async Task OnParametersSetAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        area = await db.CommunityAreas.AsNoTracking().FirstOrDefaultAsync(a => a.Id == AreaId);
        if (area is null)
        {
            found = false;
            return;
        }

        found = true;
        heroes = await db.Heroes.AsNoTracking().OrderBy(h => h.Name).ToListAsync();
        searchQuery = InitialQuery?.Trim() ?? string.Empty;
        selected.Clear();
        page = 0;
    }

    private void HandleSearchInput(ChangeEventArgs args)
    {
        searchQuery = args.Value?.ToString() ?? string.Empty;
        autocompleteVisible = !string.IsNullOrWhiteSpace(searchQuery);
    }

    private void ShowAutocomplete()
    {
        autocompleteVisible = !string.IsNullOrWhiteSpace(searchQuery);
    }

    private void ChooseSuggestion(string heroName)
    {
        searchQuery = heroName;
        autocompleteVisible = false;
    }

    private void ShowSearch()
    {
        browseAll = false;
    }

    private void ShowBrowseAll()
    {
        browseAll = true;
        autocompleteVisible = false;
    }

    private void Search()
    {
        var query = searchQuery.Trim();
        if (query.Length == 0 || !CanSearch)
        {
            autocompleteVisible = query.Length > 0;
            return;
        }

        Nav.NavigateTo($"heroes/{AreaId}/results?q={Uri.EscapeDataString(query)}");
    }

    private void ToggleSelected(int heroId, bool isSelected)
    {
        if (isSelected)
        {
            selected.Add(heroId);
        }
        else
        {
            selected.Remove(heroId);
        }
    }

    private void ChangePage(int delta)
    {
        page = Math.Clamp(page + delta, 0, TotalPages - 1);
    }

    private void GoToDeploy()
    {
        if (selected.Count == 0)
        {
            return;
        }

        var heroIdsQuery = string.Join("&", selected.OrderBy(id => id).Select(id => $"heroIds={id}"));
        Nav.NavigateTo($"deploy/{AreaId}/details?{heroIdsQuery}");
    }

    private static bool Matches(Hero hero, string query)
    {
        var value = query.Trim();
        return Contains(hero.Name, value)
            || Contains(hero.FullName, value)
            || Contains(hero.Aliases, value)
            || Contains(hero.Publisher, value);
    }

    private static bool Contains(string? value, string query) =>
        !string.IsNullOrWhiteSpace(value)
        && value.Contains(query, StringComparison.OrdinalIgnoreCase);
}
