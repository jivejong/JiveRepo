@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <header class="app-title-banner">
            <a href="" aria-label="SuperHeroOps home">
                <img src="@Assets["images/title.png"]" alt="SuperHeroOps" />
            </a>
        </header>

        <section class="app-introduction" aria-label="About SuperHeroOps">
            <p class="app-introduction-summary">
                SuperHeroOps combines real Chicago crime data with a fictional superhero
                intervention model to explore illustrative &ldquo;what if&rdquo; deployments.
            </p>
            <p class="app-introduction-steps">
                <strong>How it works:</strong> Choose a neighborhood, select one or more heroes
                using search or the full checklist, compare their modeled impact, and review the
                automatically generated reports. Projections are illustrative, not real forecasts
                or policy recommendations.
            </p>
        </section>

        <div class="top-row px-4">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
